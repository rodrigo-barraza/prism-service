{
  "name": "prism-service",
  "version": "1.0.0",
  "description": "Prism the AI Gateway — a centralized backend for routing requests to multiple AI providers",
  "type": "module",
  "main": "dist/boot.js",
  "imports": {
    "#src/*": {
      "production": "./dist/src/*.js",
      "import": "./src/*.ts"
    },
    "#config": {
      "production": "./dist/config.js",
      "import": "./config.ts"
    }
  },
  "scripts": {
    "start": "node --conditions=production dist/boot.js",
    "dev": "tsx watch boot.ts",
    "build": "rm -rf dist && tsc && mkdir -p dist/src/locales && rsync -a --exclude='__tests__' src/locales/ dist/src/locales/",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:live:agent-behavior": "vitest run --config vitest.live.config.ts tests/live/agentBehavior.live.test.ts",
    "test:live:agent-behavior:cloud": "INCLUDE_CLOUD=true vitest run --config vitest.live.config.ts tests/live/agentBehavior.live.test.ts",
    "test:lm-studio": "vitest run --config vitest.live.config.ts tests/live/lmStudioModels.live.test.js",
    "vram:bench": "node scripts/vram-bench.js",
    "vram:quick": "node scripts/vram-bench.js --skip-settings --contexts=4k,8k",
    "vram:model": "node scripts/vram-bench.js --skip-settings --contexts=4k",
    "deploy": "bash deploy.sh",
    "deploy:dry": "bash deploy.sh --dry-run"
  },
  "keywords": [
    "ai",
    "gateway",
    "openai",
    "anthropic",
    "google",
    "elevenlabs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.103.0",
    "@google/genai": "^2.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@rodrigo-barraza/service-library": "github:rodrigo-barraza/service-library",
    "@rodrigo-barraza/utilities-library": "github:rodrigo-barraza/utilities-library",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "minio": "^8.0.7",
    "mongodb": "^7.2.0",
    "openai": "^6.37.0",
    "sharp": "^0.34.5",
    "undici": "^8.4.1",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.8.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "ts-morph": "^28.0.0",
    "tsx": "^4.22.0",
    "typescript": "next",
    "typescript-eslint": "^8.33.0",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@11.8.0"
}
